# Backend Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=True

# Mode: development | production
ENV=development

# Supabase Credentials (Optional: if empty, backend uses local SQLite automatically)
# The user will provide these when ready!
SUPABASE_URL=
SUPABASE_KEY=

# Local Database Fallback Path
DATABASE_PATH=app/smart_power.db

# Relay Configuration (Active LOW is standard for most 5V relay modules)
RELAY_ACTIVE_LOW=True

# Safety Thresholds (in Milliwatts mW)
FAN_POWER_THRESHOLD_MW=6000
LED_POWER_THRESHOLD_MW=3500
TOTAL_POWER_BUDGET_MW=8500

